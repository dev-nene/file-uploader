<html>
  <head>
    <title>Homepage</title>
  </head>
  <body>
    <h1>File Uploader</h1>

    <% if (locals.user) {%>
      <h2>Welcome back <%=user.name%></h2>
      <p>Account: <%=user.email%></p>

      <a href="/upload">Upload file</a>
    
      
      <form action="/logout" method="POST">
        <button type="submit">Log out</button>
      </form>

      <a href="/folders/new">Create folder</a>

      <% if (locals.folders.length === 0) { %> 
        <p>No folders created yet</p>
      <% } else { %>
        <% for (let i = 0; i < folders.length; i++) { %> 
          <div>
            <p><%=folders[i].name %> </p>
            <p><%=folders[i].createdAt.toLocaleString() %></p>
            <a href="/folders/<%=folders[i].id%>">Details</a>
          </div>
        <% } %>
      <% } %>

      
      <% if (locals.files.length === 0) { %> 
        <p>No files uploaded yet</p>
      <% } else { %>
        <% for (let i = 0; i < files.length; i++) { %> 
          <div>
            <p><%=files[i].name %> - Size: <%= (files[i].size / 1024).toFixed(1) %> KiB </p>
            <p><%=files[i].uploadedAt.toLocaleString() %></p>
            <a href="/files/<%=files[i].id%>">Details</a>
          </div>
        <% } %>
      <% } %>
      
    <% }  else { %>
      <h2>Please register or log in</h2>
      <a href="/register">Register</a>
      <br>
      <a href="/login">Log in</a>
    <% } %>

  </body>
</html>
