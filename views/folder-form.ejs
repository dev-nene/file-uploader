<html>
  <head>
    <title>Create new folder</title>
  </head>

  <body>

    <% if (errors && errors.length > 0) { %>
      <ul>
        <% errors.forEach((error) => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    <% } %>


    <form action="/folders" method="POST">
      <label for="name">Name</label>
      <input type="text" name="name" id="name" required />
      <br />
      <button>Create Folder</button>
    </form>
  </body>
</html>
