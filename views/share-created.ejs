<html>
  <head>
    <title>Link shared</title>
  </head>
  <body>
    <h1>Share link created</h1>

    <p>Copy this link to share your folder:</p>
    <a id="share-link" href="/share/<%= share.token %>">Share link</a>

    <p>Expires: <%= share.expiresAt.toLocaleString() %></p>
  </body>
</html>

